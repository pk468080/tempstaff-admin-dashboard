:root {
  --bg: #f6f7f9;
  --surface: #ffffff;
  --border: #e5e7eb;
  --text: #111827;
  --muted: #6b7280;
  --sidebar: #111827;
  --sidebar-hover: #1f2937;
  --sidebar-active: #ffffff;
  --radius: 12px;
}

/* =========================
   APP SHELL
========================= */

.admin-shell {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
  width: 250px;
  min-height: 100vh;
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 20;

  display: flex;
  flex-direction: column;

  padding: 22px 14px;

  background: var(--sidebar);
  color: #ffffff;
}

/* Brand */

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 11px;

  padding: 6px 10px 22px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.brand-mark {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  background: #ffffff;
  color: #111827;

  font-size: 13px;
  font-weight: 800;
}

.brand-name {
  font-size: 16px;
  font-weight: 750;
  letter-spacing: -0.2px;
}

.brand-role {
  margin-top: 2px;

  color: #9ca3af;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
}

/* Navigation */

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;

  margin-top: 22px;
}

.nav-section-title {
  padding: 0 11px 8px;

  color: #6b7280;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.8px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;

  padding: 10px 11px;

  border-radius: 8px;

  color: #cbd5e1;

  font-size: 13px;
  font-weight: 500;

  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.nav-item:hover {
  background: var(--sidebar-hover);
  color: #ffffff;
}

.nav-item.active {
  background: var(--sidebar-active);
  color: #111827;
}

.nav-icon {
  width: 20px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  font-size: 15px;
}

.sidebar-bottom {
  margin-top: auto;
  padding-top: 16px;

  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.logout-button {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 11px;

  padding: 10px 11px;

  border: 0;
  border-radius: 8px;

  background: transparent;
  color: #cbd5e1;

  font-size: 13px;
  font-weight: 500;

  text-align: left;
}

.logout-button:hover {
  background: #1f2937;
  color: #ffffff;
}

/* =========================
   MAIN
========================= */

.admin-main {
  width: calc(100% - 250px);
  min-height: 100vh;

  margin-left: 250px;
}

/* =========================
   HEADER
========================= */

.admin-header {
  height: 70px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 30px;

  background: var(--surface);
  border-bottom: 1px solid var(--border);
}

.header-title {
  color: var(--text);

  font-size: 14px;
  font-weight: 700;
}

.header-subtitle {
  margin-top: 3px;

  color: var(--muted);

  font-size: 11px;
}

.admin-user {
  display: flex;
  align-items: center;
  gap: 10px;
}

.admin-avatar {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #111827;
  color: #ffffff;

  font-size: 12px;
  font-weight: 700;
}

.admin-user-name {
  color: var(--text);

  font-size: 12px;
  font-weight: 650;
}

.admin-user-role {
  margin-top: 2px;

  color: var(--muted);

  font-size: 10px;
}

/* =========================
   CONTENT
========================= */

.admin-content {
  width: 100%;
  max-width: 1600px;

  padding: 30px;
}

/* =========================
   PAGE HEADING
========================= */

.page-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 24px;
}

.page-heading h1 {
  margin: 0;

  color: var(--text);

  font-size: 28px;
  line-height: 1.2;
  font-weight: 750;

  letter-spacing: -0.7px;
}

.page-heading p {
  margin: 6px 0 0;

  color: var(--muted);

  font-size: 13px;
}

/* =========================
   BUTTONS
========================= */

.secondary-button {
  border: 1px solid #d1d5db;
  border-radius: 8px;

  padding: 9px 14px;

  background: #ffffff;
  color: #111827;

  font-size: 13px;
  font-weight: 600;

  transition: 0.15s ease;
}

.secondary-button:hover {
  background: #f9fafb;
  border-color: #9ca3af;
}

.secondary-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* =========================
   ERROR
========================= */

.error-banner {
  margin-bottom: 20px;

  padding: 12px 14px;

  border: 1px solid #fecaca;
  border-radius: 9px;

  background: #fef2f2;
  color: #b91c1c;

  font-size: 13px;
}

/* =========================
   STAT CARDS
========================= */

.stats-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;

  margin-bottom: 20px;
}

.stat-card {
  min-height: 118px;

  display: flex;
  align-items: center;
  gap: 15px;

  padding: 20px;

  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: var(--radius);

  box-shadow:
    0 1px 2px rgba(0, 0, 0, 0.03);
}

.stat-icon {
  width: 44px;
  height: 44px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  background: #f3f4f6;
  color: #111827;

  font-size: 17px;
  font-weight: 700;
}

.stat-content {
  min-width: 0;
}

.stat-title {
  color: var(--muted);

  font-size: 12px;
  font-weight: 500;
}

.stat-value {
  margin-top: 5px;

  color: var(--text);

  font-size: 25px;
  line-height: 1.1;
  font-weight: 750;

  letter-spacing: -0.5px;
}

/* =========================
   DASHBOARD PANELS
========================= */

.dashboard-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.2fr)
    minmax(320px, 0.8fr);

  gap: 20px;
}

.panel {
  overflow: hidden;

  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: var(--radius);

  box-shadow:
    0 1px 2px rgba(0, 0, 0, 0.025);
}

.panel-header {
  padding: 19px 21px;

  border-bottom: 1px solid var(--border);
}

.panel-header h2 {
  margin: 0;

  color: var(--text);

  font-size: 15px;
  font-weight: 700;
}

.panel-header p {
  margin: 4px 0 0;

  color: var(--muted);

  font-size: 12px;
}

/* =========================
   OPERATIONS
========================= */

.operation-row {
  min-height: 55px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 21px;

  border-bottom: 1px solid #f0f1f3;
}

.operation-row:last-child {
  border-bottom: 0;
}

.operation-row span {
  color: var(--muted);

  font-size: 13px;
}

.operation-row strong {
  color: var(--text);

  font-size: 13px;
  font-weight: 700;
}

/* =========================
   QUICK ACTIONS
========================= */

.quick-actions {
  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 10px;

  padding: 20px;
}

.quick-actions a {
  display: flex;
  align-items: center;

  min-height: 52px;

  padding: 0 13px;

  border: 1px solid var(--border);
  border-radius: 8px;

  background: #ffffff;
  color: var(--text);

  font-size: 12px;
  font-weight: 600;

  transition:
    border-color 0.15s ease,
    background 0.15s ease;
}

.quick-actions a:hover {
  background: #f9fafb;
  border-color: #cbd5e1;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1100px) {
  .stats-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .sidebar {
    width: 210px;
  }

  .admin-main {
    width: calc(100% - 210px);
    margin-left: 210px;
  }

  .admin-content {
    padding: 22px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .admin-header {
    padding: 0 20px;
  }
}

/* =========================
   DASHBOARD
========================= */

.admin-content {
  width: 100%;
}

.dashboard-page {
  width: 100%;
}

.dashboard-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 28px;
}

.dashboard-eyebrow {
  margin: 0 0 8px;
  color: #6b7280;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.dashboard-header h1 {
  margin: 0;
  color: #111827;
  font-size: 32px;
  line-height: 1.15;
  font-weight: 750;
  letter-spacing: -0.8px;
}

.dashboard-header p {
  margin: 8px 0 0;
  color: #6b7280;
  font-size: 14px;
}

.dashboard-refresh {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 15px;
  border: 1px solid #d1d5db;
  border-radius: 9px;
  background: #fff;
  color: #111827;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.15s ease;
}

.dashboard-refresh:hover {
  background: #f9fafb;
  border-color: #9ca3af;
}

.dashboard-refresh:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* Stats */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: 132px;
  padding: 22px;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease,
    border-color 0.15s ease;
}

.stat-card:hover {
  transform: translateY(-1px);
  border-color: #d1d5db;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
}

.stat-icon {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #f3f4f6;
  color: #111827;
  font-size: 20px;
  font-weight: 700;
}

.stat-content {
  min-width: 0;
}

.stat-title {
  color: #6b7280;
  font-size: 13px;
  font-weight: 600;
}

.stat-value {
  margin-top: 5px;
  color: #111827;
  font-size: 28px;
  line-height: 1.1;
  font-weight: 750;
  letter-spacing: -0.5px;
}

/* Error */

.error-banner {
  margin-bottom: 20px;
  padding: 13px 15px;
  border: 1px solid #fecaca;
  border-radius: 10px;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 14px;
}

/* Dashboard lower panels */

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
  gap: 20px;
}

.panel {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 22px;
  border-bottom: 1px solid #e5e7eb;
}

.panel-header h2 {
  margin: 0;
  color: #111827;
  font-size: 16px;
  font-weight: 700;
}

.panel-header p {
  margin: 5px 0 0;
  color: #6b7280;
  font-size: 13px;
}

/* Operations */

.operation-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58px;
  padding: 0 22px;
  border-bottom: 1px solid #f0f1f3;
}

.operation-row:last-child {
  border-bottom: 0;
}

.operation-row span {
  color: #6b7280;
  font-size: 14px;
}

.operation-row strong {
  color: #111827;
  font-size: 14px;
  font-weight: 700;
}

/* Quick actions */

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  padding: 20px 22px;
}

.quick-actions a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48px;
  padding: 0 14px;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
  background: #fff;
  color: #111827;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.15s ease;
}

.quick-actions a::after {
  content: '→';
  color: #9ca3af;
}

.quick-actions a:hover {
  background: #f9fafb;
  border-color: #cfd3d8;
}

/* Responsive */

@media (max-width: 1100px) {
  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .dashboard-header {
    flex-direction: column;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .quick-actions {
    grid-template-columns: 1fr;
  }
}

